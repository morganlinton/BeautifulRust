 "cards": [
  {
   "dot": "cyan",
   "title": "Boot rail",
   "items": [
    "config loads once from typed env and validates on boot; a missing secret fails closed before bind",
    "AppState::from_env opens the sqlx pool and runs the embedded sqlx::migrate! migrations; <app>-api migrate is the one-shot runner"
   ]
  },
  {
   "dot": "emerald",
   "title": "Gates + health",
   "items": [
    "readyz probes the pool and answers 503 degraded; /healthz is process-alive; /metrics sits behind auth",
    "errors return {error: {code, title, detail, request_id}}; 5xx detail redacts, rate limits carry Retry-After"
   ]
  },
  {
   "dot": "rose",
   "title": "Background + realtime",
   "items": [
    "the loom worker claims email_jobs with SKIP LOCKED and a 5-minute lease",
    "the WS upgrade authenticates after upgrade — a bad ?token= closes 4001 authentication_failed"
   ]
  }
 ]
