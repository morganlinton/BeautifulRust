 "cards": [
  {
   "dot": "cyan",
   "title": "Core state",
   "items": [
    "users carries role + provider ids; sessions hold the opaque refresh token with is_active and absolute expires_at",
    "codes live in email_verifications (6-digit · 5 tries · 24h) and password_resets (30m · 3 per 5 min)"
   ]
  },
  {
   "dot": "emerald",
   "title": "Outbox",
   "items": [
    "auth use-cases INSERT email_jobs inside the same sqlx transaction as the state change (outbox_pg adapter)",
    "claim takes queued-due rows plus sending rows past the 5-minute lease — FOR UPDATE SKIP LOCKED, at-least-once"
   ]
  },
  {
   "dot": "rose",
   "title": "Delivery + ledgers",
   "items": [
    "failures back off 2^n minutes ±10% and dead-letter to failed at max_retries 3",
    "audit_logs records admin actions; the janitor purges expired sessions and code rows hourly"
   ]
  }
 ]
