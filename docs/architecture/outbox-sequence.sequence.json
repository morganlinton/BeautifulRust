  "cards": [
    {
      "dot": "cyan",
      "title": "Zero-broker outbox",
      "items": [
        "the job row rides the same sqlx transaction as the auth write — no dual-write gap",
        "claim = queued-due-now OR sending older than the 5-minute lease, FOR UPDATE SKIP LOCKED"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "poll every 2s (OUTBOX_POLL) with batch 10 (OUTBOX_BATCH)",
        "sender: Console when OFFLINE or the host is empty, else STARTTLS via mailer::render"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure + janitor",
      "items": [
        "backoff 2^n minutes with ±10% deterministic jitter; dead-letter to failed at max_retries 3",
        "the janitor sweeps expired sessions, email_verifications and password_resets hourly"
      ]
    }
  ]
