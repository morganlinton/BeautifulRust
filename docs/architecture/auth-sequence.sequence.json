  "cards": [
    {
      "dot": "cyan",
      "title": "One transaction",
      "items": [
        "signup persists the user, the email_verifications row and the email_jobs job in a single sqlx transaction",
        "a 5-minute sending lease recovers a crashed worker"
      ]
    },
    {
      "dot": "emerald",
      "title": "Code lifecycle",
      "items": [
        "codes cap at 5 wrong guesses, expire in 24h and are consumed on verify",
        "re-signup re-issues; a verified email answers 409; resend never reveals account existence"
      ]
    },
    {
      "dot": "rose",
      "title": "Login + tokens",
      "items": [
        "password verifies first — one constant 401; state gates answer stable 403",
        "access JWT (15m) bound to the session id; refresh rotates in place — replay misses the CAS"
      ]
    }
  ]
