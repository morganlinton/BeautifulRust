  "cards": [
    {
      "dot": "cyan",
      "title": "Transactional enqueue",
      "items": [
        "auth use-cases INSERT email_jobs through the outbox_pg adapter inside the same sqlx transaction as the state change",
        "no message broker: Postgres polling is the whole delivery contract"
      ]
    },
    {
      "dot": "emerald",
      "title": "Drain",
      "items": [
        "run_outbox_worker polls OUTBOX_POLL (2s) with batch OUTBOX_BATCH (10); a batch of 0 clamps to 16",
        "the claim CTE takes queued-due rows plus sending rows older than the 5-minute lease",
        "Console sender when OFFLINE or the SMTP host is empty, else STARTTLS SMTP"
      ]
    },
    {
      "dot": "rose",
      "title": "Outcomes",
      "items": [
        "failure requeues with 2^n-minute backoff and ±10% jitter, deterministic per job + attempt",
        "dead-letters to status failed at max_retries 3; the janitor purges expired sessions and code rows hourly"
      ]
    }
  ]
